# fetch/enrich caches: Wikipedia, Wikidata, Douban and RT responses plus IMDb datasets (~550 MB, rebuildable)
pipeline/cache/
pipeline/imdb/

# headless Chrome profiles the Douban scripts create; they hold cookies
pipeline/chrome-profile*/

# the fetch, Douban and enrich scripts drive third-party sites and stay local;
# the site builds from the committed JSON with `make build`
pipeline/local/

# test screenshots
pipeline/tests/*.png

__pycache__/
.claude/
*.log
.DS_Store

# build output for the claude.ai preview (make build writes it)
pipeline/artifact.html
